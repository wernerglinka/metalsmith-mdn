{
  "name": "metalsmith-mdn",
  "version": "1.1.0",
  "description": "MDN is a Metalsmith plugin that lets you use Nunjucks components in markdown content",
  "type": "module",
  "keywords": [
    "metalsmith-mdn",
    "nunjucks components",
    "metalsmith-plugin",
    "metalsmith",
    "static-site"
  ],
  "exports": "./src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wernerglinka/metalsmith-mdn.git"
  },
  "files": [
    "src/**/*.js",
    "LICENSE",
    "README.md"
  ],
  "author": "Werner Glinka (https://glinka.co)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wernerglinka/metalsmith-mdn/issues"
  },
  "homepage": "https://github.com/wernerglinka/metalsmith-mdn#readme",
  "dependencies": {
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "auto-changelog": "^2.5.0",
    "depcheck": "^1.4.7",
    "marked": "^16.4.2",
    "metalsmith": "^2.5.0",
    "release-it": "^20.0.0"
  },
  "scripts": {
    "changelog": "auto-changelog -u --commit-limit false --ignore-commit-pattern '^((dev|chore|ci):|Release)'",
    "test": "node --test --test-timeout=15000 'test/**/*.test.js'",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-timeout=15000 'test/**/*.test.js'",
    "test:coverage": "npm run coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "pre-release": "npm run lint:check && npm run format:check && npm test && npx metalsmith-plugin-mcp-server validate .",
    "release:patch": "./scripts/release.sh patch --ci",
    "release:minor": "./scripts/release.sh minor --ci",
    "release:major": "./scripts/release.sh major --ci",
    "release:check": "npm run lint:check && release-it --dry-run",
    "depcheck": "depcheck",
    "audit": "npm audit"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
